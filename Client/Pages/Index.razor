@page "/"
@using music_manager_starter.Shared
<!--(*NEWBYME*) importing namespace for SearchService -->
@using music_manager_starter.Client.Services
<!-- (*NEWBYME*) injecting SearchService to get access to SearchService.SearchTerm and OnSearchChanged -->
@inject SearchService SearchService

@inject HttpClient Http

@code {
    private List<Song> songs;
    //(*NEWBYME*) adding Song list for filtered songs (songs to be displayed with search bar)
    private List<Song> filteredSongs;
    //(*NEWBYME*) adding var for hoveredSongId. needs to be nullable
    private Guid? hoveredSongId;
    //blazor lifecycle method; called when Index.razor is initialized
    protected override async Task OnInitializedAsync()
    {
        songs = await Http.GetFromJsonAsync<List<Song>>("api/songs");
        //(*NEWBYME*) initialize filteredSongs with full song list
        filteredSongs = songs;
        /*(*NEWBYME*) add FilterSongs as listener/subscriber for OnSearchChange event. FilterSongs gets called
        when search term updates and OnSearchChanged gets invoked in Services/SearchService.cs */
        SearchService.OnSearchChanged += FilterSongs;
        //(*NEWBYME*) applying initial search term in search bar
        FilterSongs();
    }

    /*(*NEWBYME*) adding GetHoverStyle function to return proper background style when hovering 
    over a song tile; either black or album art */
    private string GetHoverStyle(Song song){
        if(song.Art != null){
            string base64 = Convert.ToBase64String(song.Art);
            return $"background-image: url('data:image/jpeg;base64,{base64}'); background-size: cover; background-position: center;";
        }
        return "background-color: black;";
    }

    /*(*NEWBYME*) adding FilterSongs function; setting filteredSongs to contain the songs which match
    keywords typed into search bar*/
    private void FilterSongs(){
        if(songs == null){
            return;
        }

        string searchTerm = SearchService.SearchTerm.ToLower();

        //if there is no text in the search bar, set filteredSongs to songs (to display all songs)
        if(string.IsNullOrEmpty(searchTerm)){
            filteredSongs = songs;
        }
        else{
            filteredSongs = songs.Where(s =>
                s.Title.ToLower().Contains(searchTerm) ||
                s.Artist.ToLower().Contains(searchTerm) ||
                s.Album.ToLower().Contains(searchTerm)                
            ).ToList();
        }
        
        //re-render ui when filteredSongs changes
        StateHasChanged();
    }

    /*(*NEWBYME*)
    private void Dispose(){
        SearchService.OnSearchChanged -= FilterSongs;
    }*/
}

<div class="p-0 min-h-screen bg-pattern flex flex-col items-center justify-center">
    <h2 class="text-3xl font-bold text-white mb-8 text-center">Song Library</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
        <!-- (*NEWBYME*) replacing songs with filteredSongs -->
        @if (filteredSongs != null && filteredSongs.Count > 0)
        {
            //(*NEWBYME*) replacing songs with filteredSongs
            @foreach (var song in filteredSongs)
            {
                <!-- (*NEWBYME*) editing song div to handle onmouseover and onmouseout.
                - Id of song being hovered gets set to hoveredSongId.
                - style of the div gets dynamically set, based on if it is hovered or not.
                Without the conditional, every tile would have an art or black background constantly  -->
                <div class="glass p-6 border border-gray-300 rounded-lg text-white transition-transform transform hover:scale-105 hover:shadow-xl cursor-pointer"
                    @onmouseover="@(() => hoveredSongId = song.Id)"
                    @onmouseout="@(() => hoveredSongId = null)"
                    style="@(hoveredSongId == song.Id ? GetHoverStyle(song) : "")">
                    
                    <!-- song Title and Artist will always be rendered -->
                    <h3 class="text-xl font-semibold mb-2">@song.Title</h3>
                    <p class="text-md">Artist: <span class="font-light">@song.Artist</span></p>
                
                    <!-- (*NEWBYME*) adding if statement which will display detailed song information when
                    song tile is hovered (only for the currently hovered tile) -->
                    @if (hoveredSongId == song.Id){
                        <p class="text-md">Genre: <span class="font-light">@(song.Genre)</span></p>
                        
                    }

                </div>
            }
        }
        else
        {
            <div class="col-span-1 text-center text-gray-400">No songs found.</div>
        }
    </div>
</div>

<style>
    .bg-pattern {
        background: linear-gradient( rgba(31, 41, 55, 0.7), rgba(31, 41, 55, 0.7) ), url('dalle.webp');
        background-size: cover;
        background-position: center;
        font-family: 'Rajdhani', sans-serif;
    }

 

    .glass {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px); 
        border-radius: 10px; 
        position: relative; 
        overflow: hidden; 
    }

        .glass:before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            pointer-events: none; 
        }
</style>